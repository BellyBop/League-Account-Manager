{
  "name": "league-acc-manager",
  "version": "1.1.1",
  "description": "A desktop manager for your League of Legends main and smurf accounts.",
  "main": "main.js",
  "author": "jnathanbotha",
  "license": "MIT",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "dist": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.bellybop.league-acc-manager",
    "productName": "League Account Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ipcChannels.js",
      "riot.js",
      "ipc/**/*",
      "lib/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "AccManageIcon.ico"
    }
  }
}
